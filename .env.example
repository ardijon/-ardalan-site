# ====================================
# Ardalan — Environment Variables
# ====================================
# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
# ====================================

# --- Telegram Bot (Contact Form Notifications) ---
# Create a bot via @BotFather on Telegram, then paste the token here.
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# Your Telegram numeric chat ID (use @userinfobot to find it).
TELEGRAM_CHAT_ID=123456789

# --- Optional: External Visitor Counter (Cloudflare Worker) ---
# If you deploy the Cloudflare Worker in /worker, set its URL here.
# Without this, the counter falls back to /api/visitors (file-based).
# NEXT_PUBLIC_COUNTER_URL=https://your-worker.your-subdomain.workers.dev

# --- Admin Panel (Product Management) ---
# Credentials for /admin panel access
ADMIN_USER=admin
ADMIN_PASS=your-secure-password-here

# --- Optional: Analytics ---
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
