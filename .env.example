# ====================================
# Ardalan — Environment Variables
# ====================================
# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
# ====================================

# --- Telegram Bot (Contact Form Notifications) ---
# Create a bot via @BotFather on Telegram, then paste the token here.
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# Your Telegram numeric chat ID (use @userinfobot to find it).
TELEGRAM_CHAT_ID=123456789

# --- Admin Panel (Product Management) ---
# Credentials for /admin panel access
ADMIN_USER=admin
ADMIN_PASS=your-secure-password-here

# --- Admin Session Cookie ---
# Signs the HMAC session cookie issued after a successful OTP check.
# Optional: if unset it falls back to ADMIN_USER:ADMIN_PASS, which works but
# logs everyone out whenever the password changes. Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Admin OTP (Telegram) ---
# Your Telegram numeric chat ID for receiving OTP codes
ADMIN_TELEGRAM_ID=

# --- Payment Info (Card-to-Card) ---
BANK_NAME=بلوبانک سامان
CARD_NUMBER=6219-8618-7624-0465
ACCOUNT_HOLDER=نام صاحب حساب

# --- Optional: Analytics ---
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Optional: Data directory (plain Node hosts only) ---
# On Cloudflare Workers, orders and product edits go to the SITE_KV namespace and
# this variable is ignored. On a plain Node host (VPS, cPanel) src/lib/storage.js
# falls back to JSON files, and by default writes them to src/data/ — which is
# committed to git, so the next `git pull` would overwrite live orders.
#
# Point this at a directory OUTSIDE the repository. Absolute paths are supported.
#   mkdir -p /var/lib/ardalan-data && cp src/data/*.json /var/lib/ardalan-data/
# DATA_DIR=/var/lib/ardalan-data
